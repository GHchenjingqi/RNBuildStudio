{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RNBuild Studio",
  "version": "0.1.0",
  "identifier": "com.rnbuild.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RNBuild Studio — RNbase 打包工作台",
        "width": 1120,
        "height": 780,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": false
  }
}
